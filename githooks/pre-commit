#!/usr/bin/env bash
#
# MASTERPLAN pre-commit gate.
#
#   1. src still builds. components.js and app.css are committed here, so a
#      commit that does not compile would publish a stale bundle to GitHub
#      Pages alongside source that no longer produces it.
#   2. UI system conformance (npm run audit:ui) — blocks on ERROR only.
#      Warnings (dead CSS) do not block.
#   3. Unit tests (npm test). These cover the layout maths and the parsers —
#      the failures that are silent and wrong rather than loud and broken.
#
# Rebuilding here also refreshes the working-tree bundle, so the running app
# picks up the commit without a separate build.
#
# Skip once with:  git commit --no-verify

set -e

# Git normally invokes hooks from the worktree root, but do not rely on that:
# Windows' npm launcher can hand cmd.exe a UNC directory and make it start at
# C:\Windows instead. Resolve the root before every project command.
repo_root="$(git rev-parse --show-toplevel)" || {
  echo "✖ pre-commit: could not resolve the Git repository root." >&2
  exit 1
}
cd "$repo_root"

# A non-interactive WSL shell can inherit only Windows npm from /mnt/c while
# node itself is absent. Calling that npm launches cmd.exe and loses the WSL
# worktree. Prefer the NVM-managed Linux toolchain in either case.
tool_is_windows_mounted() {
  [[ "$1" == /mnt/* ]]
}

node_path="$(command -v node || true)"
npm_path="$(command -v npm || true)"
if [[ -z "$node_path" || -z "$npm_path" ]] || \
   tool_is_windows_mounted "$node_path" || tool_is_windows_mounted "$npm_path"; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    # shellcheck source=/dev/null
    . "$NVM_DIR/nvm.sh"
  fi
fi

node_path="$(command -v node || true)"
npm_path="$(command -v npm || true)"
if [[ -z "$node_path" || -z "$npm_path" ]] || \
   tool_is_windows_mounted "$node_path" || tool_is_windows_mounted "$npm_path"; then
  echo "✖ pre-commit: Linux-native Node.js and npm are required in WSL." >&2
  echo "  node: ${node_path:-not found}" >&2
  echo "  npm:  ${npm_path:-not found}" >&2
  echo "  A /mnt/* path is Windows tooling and cannot run this hook safely." >&2
  echo '  Install/select Node with NVM, then retry (for example: source "$HOME/.nvm/nvm.sh").' >&2
  exit 1
fi

# Nothing relevant staged? Nothing to check.
#
# Every hand-written file the build id hashes counts, not just src/: index.html
# and the three classic scripts it loads. Each is hashed, so a commit touching
# only one of them leaves version.js stale, and each is read by the tests as a
# global — PAGES and ICONS from config.js, simulate() from simulation.js, the
# tokens from themes.js — so each can break a test without a line of src/
# moving. Both failures would otherwise wait until the push.
#
# The manifest and assets/ are hashed too: they are the installable app, and a
# stale version.js would make deploy:check report a deploy that never happened. The generated files
# are outputs and never triggers; they are what rebuilding produces.
if git diff --cached --quiet -- src config.js simulation.js themes.js index.html manifest.webmanifest assets; then
  exit 0
fi

# ---- 1. src compiles --------------------------------------------------------
if ! npm run build >/dev/null 2>&1; then
  echo "✖ pre-commit: build failed. Run 'npm run build' to see the error." >&2
  exit 1
fi

# ---- 2. UI system audit -----------------------------------------------------
if ! npm run audit:ui --silent; then
  echo "" >&2
  echo "✖ pre-commit: UI audit found errors (warnings do not block)." >&2
  echo "  Details above. Bypass with 'git commit --no-verify' if intentional." >&2
  echo "" >&2
  exit 1
fi

# ---- 3. unit tests ----------------------------------------------------------
if ! npm test --silent >/dev/null 2>&1; then
  echo "" >&2
  echo "✖ pre-commit: unit tests failed. Run 'npm test' to see which." >&2
  echo "  Bypass with 'git commit --no-verify' if intentional." >&2
  echo "" >&2
  exit 1
fi

exit 0
