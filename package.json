{
  "name": "@nemetona/masterplan",
  "version": "1.0.0",
  "description": "",
  "main": "components.js",
  "scripts": {
    "prepare": "git config core.hooksPath githooks || true; npm run build",
    "build": "node scripts/build-components.js && node scripts/build-styles.js",
    "watch": "node scripts/watch-components.js",
    "dev": "node scripts/local-dev-server.js",
    "test": "node scripts/run-tests.js",
    "test:watch": "vitest",
    "audit:ui": "node scripts/audit-ui.js",
    "theme:check": "node scripts/check-theme-contrast.js",
    "perf:check": "node scripts/check-bundle-size.js",
    "style:check": "node scripts/check-style-contract.js",
    "analyze:code": "node scripts/analyze-code.js",
    "verify": "npm test && npm run build && npm run perf:check && npm run style:check && npm run theme:check && npm run analyze:code && npm run audit:ui",
    "icon": "node scripts/make-icon.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "esbuild": "0.28.0",
    "jsdom": "^30.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "^4.1.11"
  }
}
